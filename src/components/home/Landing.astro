---
/*
  Bespoke bilingual homepage for the splash template.
  Both locales' copy live in COPY below (one source, like courses.mjs), so EN and
  AZ can't drift. Each locale's index.mdx renders <Landing lang="en|az" />.
  Styles are Astro-scoped; brand tokens (--ember, --brand-ease, …) come from
  src/styles/brand.css.
*/
interface Props {
	lang: 'en' | 'az';
}
const { lang } = Astro.props;

const COPY = {
	en: {
		byline: 'Rufat Malikov · QA automation engineer, 9+ years',
		h1: 'Learn software testing, hands-on and free.',
		tagline:
			'Free courses in test automation — Playwright and Python, in English and Azerbaijani. Learn the concepts, practice in your browser, then test a real app you run locally.',
		ctas: [
			{ text: 'Start the Playwright course', href: '/en/course/', variant: 'primary' },
			{ text: 'Start Python from zero', href: '/en/python/', variant: 'secondary' },
		],
		meta: 'Four free tracks · 35+ modules · English & Azerbaijani · no sign-up.',
		chooseText: 'Not sure where to start?',
		chooseLink: { text: 'Choose a course →', href: '/en/courses/' },
		report: {
			file: 'testmarket.spec.ts',
			rows: [
				'adds a product to the cart',
				'checkout creates an order',
				'GET /api/products → 200',
				'reset seeds a clean database',
			],
			passed: '9 passed',
			failed: '0 failed',
			time: '2.1s',
		},
		tracksHeading: 'Four free learning tracks',
		primary: [
			{
				tag: 'JavaScript · Playwright',
				title: 'Playwright course',
				body: 'Beginner-friendly, in English and Azerbaijani. Learn the concepts, practice in BrauzerLab, then write full suites against a real app.',
				link: { text: 'Start the course →', href: '/en/course/' },
				alt: { text: 'Practice in BrauzerLab →', href: '/en/playwright/' },
			},
			{
				tag: 'Python · from zero',
				title: 'Python Fundamentals',
				body: 'Write real code right in your browser — nothing to install. The foundation that testing, data, and AI all build on.',
				link: { text: 'Start Python →', href: '/en/python/' },
			},
		],
		secondary: [
			{
				tag: 'Python · advanced',
				title: 'Python for SDETs',
				body: 'Real API and UI tests with pytest, requests, and Playwright — wired into CI.',
				href: '/en/python-sdet/',
			},
			{
				tag: '11 primers',
				title: 'Reference',
				body: 'Short, plain-language primers — HTTP, SQL, Git, selectors, regex, Docker.',
				href: '/en/reference/',
			},
		],
		howHeading: 'How the courses work',
		steps: [
			{ title: 'Learn the concept', body: 'Short, plain-language lessons. No fluff, no gatekeeping.' },
			{ title: 'Practice in the browser', body: 'Write real code and watch it run instantly — no setup.' },
			{ title: 'Test a real app', body: 'Point your suites at TestMarket Lab, a real app you run locally.' },
		],
		alsoHeading: 'Also here',
		also: [
			{ title: 'Projects', body: 'Free QA and study tools I’ve built.', href: '/en/projects/' },
			{ title: 'Exam Helper', body: 'Browser-based exam prep for students in Azerbaijan.', href: '/en/exam-helper/' },
			{ title: 'About', body: '9+ years in test automation, and why I teach.', href: '/en/about/' },
		],
	},
	az: {
		byline: 'Rüfət Məlikov · QA avtomatlaşdırma mühəndisi, 9+ il',
		h1: 'Proqram testini praktiki və pulsuz öyrən.',
		tagline:
			'Test avtomatlaşdırma üzrə pulsuz kurslar — Playwright və Python, ingilis və Azərbaycan dilində. Konsepsiyaları öyrən, brauzerdə məşq et, sonra yerli işlətdiyin real tətbiqi test et.',
		ctas: [
			{ text: 'Playwright kursuna başla', href: '/az/course/', variant: 'primary' },
			{ text: 'Sıfırdan Python-a başla', href: '/az/python/', variant: 'secondary' },
		],
		meta: 'Dörd pulsuz istiqamət · 35+ modul · İngilis və Azərbaycan dilində · qeydiyyat yoxdur.',
		chooseText: 'Haradan başlayacağını bilmirsən?',
		chooseLink: { text: 'Kurs seç →', href: '/az/courses/' },
		report: {
			file: 'testmarket.spec.ts',
			rows: [
				'səbətə məhsul əlavə edir',
				'ödəniş sifariş yaradır',
				'GET /api/products → 200',
				'reset təmiz baza yükləyir',
			],
			passed: '9 keçdi',
			failed: '0 uğursuz',
			time: '2.1s',
		},
		tracksHeading: 'Dörd pulsuz öyrənmə istiqaməti',
		primary: [
			{
				tag: 'JavaScript · Playwright',
				title: 'Playwright kursu',
				body: 'İngilis və Azərbaycan dilində, başlayanlar üçün. Konsepsiyaları öyrən, BrauzerLab-da məşq et, sonra real tətbiqə qarşı tam test dəstləri yaz.',
				link: { text: 'Kursa başla →', href: '/az/course/' },
				alt: { text: 'BrauzerLab-da məşq et →', href: '/az/playwright/' },
			},
			{
				tag: 'Python · sıfırdan',
				title: 'Python Əsasları',
				body: 'Real kodu birbaşa brauzerində yaz — heç nə quraşdırmadan. Testin, datanın və AI-nin üzərində qurulduğu təməl.',
				link: { text: 'Python-a başla →', href: '/az/python/' },
			},
		],
		secondary: [
			{
				tag: 'Python · qabaqcıl',
				title: 'SDET-lər üçün Python',
				body: 'pytest, requests və Playwright ilə real API və UI testləri — CI-yə bağlı.',
				href: '/az/python-sdet/',
			},
			{
				tag: '11 səhifə',
				title: 'İstinad',
				body: 'Qısa, sadə dildə səhifələr — HTTP, SQL, Git, seçicilər, regex, Docker.',
				href: '/az/reference/',
			},
		],
		howHeading: 'Kurslar necə işləyir',
		steps: [
			{ title: 'Konsepsiyanı öyrən', body: 'Qısa, sadə dildə dərslər. Artıq söz yox, süni maneə yox.' },
			{ title: 'Brauzerdə məşq et', body: 'Real kodu yaz və dərhal necə işlədiyini gör — quraşdırma yoxdur.' },
			{ title: 'Real tətbiqi test et', body: 'Dəstlərini yerli işlətdiyin real tətbiq TestMarket Lab-a yönəlt.' },
		],
		alsoHeading: 'Həmçinin burada',
		also: [
			{ title: 'Layihələr', body: 'Qurduğum pulsuz QA və təhsil alətləri.', href: '/az/projects/' },
			{ title: 'İmtahan Köməkçisi', body: 'Azərbaycandakı şagirdlər üçün brauzerdə imtahan hazırlığı.', href: '/az/exam-helper/' },
			{ title: 'Haqqımda', body: 'Test avtomatlaşdırmada 9+ il — və niyə öyrədirəm.', href: '/az/about/' },
		],
	},
} as const;

const t = COPY[lang];
---

<div class="home">
	<!-- ============ Hero ============ -->
	<section class="hero-band">
		<div class="hero-copy">
			<p class="byline reveal">{t.byline}</p>
			<h1 class="reveal r1">{t.h1}</h1>
			<p class="tagline reveal r2">{t.tagline}</p>
			<div class="cta-row reveal r3">
				{t.ctas.map((c) => (
					<a class:list={['sl-link-button', c.variant]} href={c.href}>{c.text}</a>
				))}
			</div>
			<p class="meta reveal r4">
				<span>{t.meta}</span>{' '}
				<span class="meta-choose">{t.chooseText} <a href={t.chooseLink.href}>{t.chooseLink.text}</a></span>
			</p>
		</div>

		<!-- Signature visual: a passing test report against the course's own app -->
		<div class="report reveal r2" role="img" aria-label={`A passing test run: ${t.report.rows.join('; ')}. ${t.report.passed}, ${t.report.failed}.`}>
			<div class="report-bar" aria-hidden="true">
				<span class="dot"></span><span class="dot"></span><span class="dot"></span>
				<span class="report-file">{t.report.file}</span>
			</div>
			<ul class="report-rows" aria-hidden="true">
				{t.report.rows.map((r, i) => (
					<li style={`--i:${i}`}>
						<svg class="tick" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<span>{r}</span>
					</li>
				))}
			</ul>
			<div class="report-foot" aria-hidden="true">
				<span class="pass">{t.report.passed}</span>
				<span class="fail">{t.report.failed}</span>
				<span class="time">{t.report.time}</span>
			</div>
		</div>
	</section>

	<!-- ============ Learning tracks ============ -->
	<section class="tracks">
		<h2>{t.tracksHeading}</h2>
		<div class="tracks-primary">
			{t.primary.map((p) => (
				<article class="track">
					<span class="track-tag">{p.tag}</span>
					<h3>{p.title}</h3>
					<p>{p.body}</p>
					<p class="track-links">
						<a href={p.link.href}>{p.link.text}</a>
						{'alt' in p && p.alt ? <> · <a href={p.alt.href}>{p.alt.text}</a></> : null}
					</p>
				</article>
			))}
		</div>
		<div class="tracks-secondary">
			{t.secondary.map((s) => (
				<a class="track-row" href={s.href}>
					<span class="track-tag">{s.tag}</span>
					<span class="track-row-title">{s.title}</span>
					<span class="track-row-body">{s.body}</span>
					<span class="track-row-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</div>
	</section>

	<!-- ============ How it works ============ -->
	<section class="how">
		<h2>{t.howHeading}</h2>
		<ol class="steps">
			{t.steps.map((s, i) => (
				<li>
					<span class="step-n" aria-hidden="true">{i + 1}</span>
					<h3>{s.title}</h3>
					<p>{s.body}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- ============ Also here ============ -->
	<section class="also">
		<h2>{t.alsoHeading}</h2>
		<div class="also-rows">
			{t.also.map((a) => (
				<a class="also-row" href={a.href}>
					<span class="also-title">{a.title}</span>
					<span class="also-body">{a.body}</span>
					<span class="also-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</div>
	</section>
</div>

<style>
	/* Splash renders the frontmatter title in its own .content-panel as the #_top
	   <h1>; our hero supplies the real, descriptive <h1>. Hide that whole title
	   panel on the homepage only (scoped via main:has(.home)) so the page keeps a
	   single h1 for SEO + a11y and no empty bordered band is left behind. */
	:global(main:has(.home) .content-panel:has(#_top)) {
		display: none;
	}

	/* Reset the prose margins Starlight applies to markdown children. */
	.home {
		margin-top: -1rem;
	}
	.home :global(h2) {
		border-bottom: 0 !important;
		padding-bottom: 0;
	}
	.home section + section {
		margin-top: clamp(3rem, 7vmin, 5.5rem);
	}
	/* Buttons live inside .sl-markdown-content, whose prose <a> rule adds an
	   underline — strip it so CTAs read as buttons, not links. */
	.home :global(.sl-link-button) {
		text-decoration: none;
	}

	/* ---------- Hero ---------- */
	.hero-band {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(2rem, 5vmin, 3.5rem);
		align-items: center;
		padding-block: clamp(1.5rem, 5vmin, 3.5rem);
	}
	@media (min-width: 55rem) {
		.hero-band {
			grid-template-columns: 1.05fr 0.95fr;
		}
	}
	.byline {
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text-accent);
		letter-spacing: 0.01em;
		margin: 0 0 0.9rem;
	}
	/* Grid children default to min-width:auto, which lets long content push past
	   the viewport on narrow screens — pin them to 0 so everything stays inside. */
	.hero-copy,
	.report,
	.track,
	.track-row,
	.steps li,
	.also-row {
		min-width: 0;
	}
	.hero-copy h1 {
		font-family: var(--brand-display);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.02;
		font-size: clamp(2.5rem, 6vw, 3.9rem);
		margin: 0;
		text-wrap: balance;
		overflow-wrap: break-word;
		color: var(--sl-color-white);
	}
	.tagline {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		max-width: 34ch;
		margin: 1.1rem 0 0;
		text-wrap: pretty;
	}
	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.meta {
		margin-top: 1.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		line-height: 1.6;
	}
	.meta span:first-child {
		color: var(--sl-color-gray-2);
		font-weight: 600;
	}
	.meta-choose {
		white-space: nowrap;
	}

	/* ---------- Report card ---------- */
	.report {
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--brand-radius);
		background: var(--sl-color-bg);
		box-shadow: var(--sl-shadow-lg);
		overflow: hidden;
		font-family: var(--sl-font-system-mono);
		font-size: 0.85rem;
		justify-self: stretch;
	}
	.report-bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.7rem 0.9rem;
		background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}
	.dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--sl-color-gray-5);
	}
	.report-file {
		margin-inline-start: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: 0.8rem;
	}
	.report-rows {
		list-style: none;
		margin: 0;
		padding: 0.9rem 0.9rem 0.5rem;
	}
	.report-rows li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.32rem 0;
		color: var(--sl-color-gray-2);
	}
	.tick {
		flex: none;
		color: oklch(0.62 0.13 155);
	}
	:global([data-theme='light']) .tick {
		color: oklch(0.52 0.13 155);
	}
	.report-foot {
		display: flex;
		gap: 1rem;
		padding: 0.7rem 0.9rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		background: color-mix(in srgb, var(--sl-color-gray-6) 30%, transparent);
		font-size: 0.8rem;
	}
	.report-foot .pass {
		color: oklch(0.55 0.13 155);
		font-weight: 600;
	}
	:global([data-theme='dark']) .report-foot .pass {
		color: oklch(0.7 0.13 155);
	}
	.report-foot .fail {
		color: var(--sl-color-gray-4);
	}
	.report-foot .time {
		margin-inline-start: auto;
		color: var(--sl-color-gray-4);
	}

	/* ---------- Tracks ---------- */
	.tracks h2,
	.how h2,
	.also h2 {
		font-family: var(--brand-display);
		font-weight: 600;
		letter-spacing: -0.02em;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		margin: 0 0 1.5rem;
		color: var(--sl-color-white);
	}
	.tracks-primary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	@media (min-width: 45rem) {
		.tracks-primary {
			grid-template-columns: 1fr 1fr;
		}
	}
	.track {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: var(--brand-radius);
		padding: 1.5rem 1.6rem;
		background: var(--sl-color-bg);
		transition: border-color var(--brand-med) ease, transform var(--brand-med) var(--brand-ease),
			box-shadow var(--brand-med) ease;
	}
	.track:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-3px);
		box-shadow: var(--sl-shadow-md);
	}
	.track-tag {
		display: inline-block;
		font-family: var(--sl-font-system-mono);
		font-size: 0.72rem;
		letter-spacing: 0.02em;
		color: var(--sl-color-text-accent);
		text-transform: none;
		margin-bottom: 0.7rem;
	}
	.track h3 {
		font-family: var(--brand-display);
		font-weight: 600;
		letter-spacing: -0.01em;
		font-size: 1.35rem;
		margin: 0 0 0.5rem;
		color: var(--sl-color-white);
	}
	.track p {
		color: var(--sl-color-gray-2);
		line-height: 1.55;
		margin: 0;
	}
	.track-links {
		margin-top: 1rem !important;
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.track-links a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.track-links a:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.tracks-secondary {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-top: 1rem;
	}
	@media (min-width: 45rem) {
		.tracks-secondary {
			grid-template-columns: 1fr 1fr;
		}
	}
	.track-row {
		display: grid;
		grid-template-columns: auto 1fr auto;
		grid-template-areas: 'tag tag arrow' 'title title arrow' 'body body arrow';
		align-items: start;
		gap: 0.15rem 0.75rem;
		padding: 1.1rem 1.3rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--brand-radius);
		text-decoration: none;
		transition: border-color var(--brand-med) ease, background var(--brand-med) ease;
	}
	.track-row:hover {
		border-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 5%, transparent);
	}
	.track-row .track-tag {
		grid-area: tag;
		margin: 0;
	}
	.track-row-title {
		grid-area: title;
		font-family: var(--brand-display);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--sl-color-white);
	}
	.track-row-body {
		grid-area: body;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		margin-top: 0.15rem;
	}
	.track-row-arrow {
		grid-area: arrow;
		align-self: center;
		color: var(--sl-color-text-accent);
		font-size: 1.2rem;
		transition: transform var(--brand-fast) var(--brand-ease);
	}
	.track-row:hover .track-row-arrow {
		transform: translateX(3px);
	}

	/* ---------- How it works ---------- */
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.75rem;
		counter-reset: step;
	}
	@media (min-width: 45rem) {
		.steps {
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}
	}
	.steps li {
		position: relative;
		padding-top: 0.4rem;
	}
	.steps li::before {
		content: '';
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		width: 2.5rem;
		height: 2px;
		background: var(--sl-color-accent);
	}
	.step-n {
		font-family: var(--brand-display);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--sl-color-text-accent);
	}
	.steps h3 {
		font-family: var(--brand-display);
		font-weight: 600;
		font-size: 1.25rem;
		letter-spacing: -0.01em;
		margin: 0.35rem 0 0.4rem;
		color: var(--sl-color-white);
	}
	.steps p {
		margin: 0;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
		max-width: 30ch;
	}

	/* ---------- Also here ---------- */
	.also-rows {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.6rem;
	}
	.also-row {
		display: grid;
		grid-template-columns: minmax(7rem, auto) 1fr auto;
		align-items: baseline;
		gap: 0.5rem 1.1rem;
		padding: 0.9rem 1.1rem;
		border-radius: var(--brand-radius-sm);
		text-decoration: none;
		border: 1px solid transparent;
		transition: border-color var(--brand-fast) ease, background var(--brand-fast) ease;
	}
	.also-row:hover {
		border-color: var(--sl-color-hairline);
		background: color-mix(in srgb, var(--sl-color-gray-6) 30%, transparent);
	}
	.also-title {
		font-family: var(--brand-display);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--sl-color-white);
	}
	.also-body {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.also-arrow {
		color: var(--sl-color-text-accent);
