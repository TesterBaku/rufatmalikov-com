---
interface Props {
	id?: string;
	title?: string;
}

const { id, title = 'Video' } = Astro.props;
---

<div class="video-wrapper">
	{id ? (
		<iframe
			src={`https://www.youtube-nocookie.com/embed/${id}`}
			title={title}
			loading="lazy"
			allowfullscreen
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
		></iframe>
	) : (
		<div class="video-placeholder">
			<span>Video tezliklə əlavə olunacaq</span>
		</div>
	)}
</div>

<style>
	.video-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 0.5rem;
		background-color: var(--sl-color-bg-nav);
		margin-block: 1.5rem;
	}

	.video-wrapper iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: none;
	}

	.video-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px dashed var(--sl-color-gray-5);
		border-radius: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: 1rem;
		font-style: italic;
	}
</style>
