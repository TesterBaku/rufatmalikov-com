---
interface Props {
	href: string;
	title: string;
}

const { href, title } = Astro.props;
---

<a class="deck-card" href={href} target="_blank" rel="noopener noreferrer">
	<span class="deck-icon" aria-hidden="true">📊</span>
	<span class="deck-body">
		<span class="deck-title">{title}</span>
		<span class="deck-sub">Slaydlar — yeni pəncərədə açılır</span>
	</span>
	<span class="deck-arrow" aria-hidden="true">↗</span>
</a>

<style>
	.deck-card {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		width: 100%;
		padding: 0.875rem 1.125rem;
		margin-block: 1rem;
		background-color: var(--sl-color-bg-nav);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		color: var(--sl-color-text);
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.deck-card:hover {
		border-color: var(--sl-color-text-accent);
		background-color: var(--sl-color-bg-sidebar);
	}

	.deck-icon {
		font-size: 1.5rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.deck-body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		flex: 1;
		min-width: 0;
	}

	.deck-title {
		font-size: 1rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
		line-height: 1.3;
	}

	.deck-sub {
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}

	.deck-arrow {
		font-size: 1.1rem;
		color: var(--sl-color-gray-3);
		flex-shrink: 0;
		transition: color 0.15s ease;
	}

	.deck-card:hover .deck-arrow {
		color: var(--sl-color-text-accent);
	}
</style>
