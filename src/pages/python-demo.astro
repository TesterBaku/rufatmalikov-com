---
/**
 * M1+M2 verification page for the Python runtime (NOT part of the course).
 * Standalone (outside Starlight) so it stays out of the sidebar; noindex'd and
 * excluded from the sitemap (see astro.config.mjs). Safe to delete in M5.
 */
import PyRunner from '../components/python/PyRunner.astro';
import Mission from '../components/python/Mission.astro';
import ModuleProgress from '../components/python/ModuleProgress.astro';

const helloCode = 'print("Salam, Dünya!")\nprint("Python brauzerdə işləyir 🐍")';
const errorCode = 'x = 10\nprint(x)\nprint(y)  # y təyin olunmayıb — NameError';
const syntaxCode = 'print("əvvəl")\nif True\n    print("sonra")  # iki nöqtə yoxdur — SyntaxError (2-ci sətir)';
const loopCode = '# Bu sonsuz dövrdür. Run-a basın: ~5 saniyəyə avtomatik dayandırılmalıdır.\nwhile True:\n    pass';
const inputCode = 'ad = input("Adın nədir? ")\nyas = input("Neçə yaşın var? ")\nprint(f"Salam, {ad}! Sən {yas} yaşındasan.")';

// Mission demos (M2)
const passStarter = 'print("salam")';
const failStarter = 'print("xeyr")';
const salamCheck = `assert "salam" in _stdout.lower(), "HINT:Çıxış 'salam' sözünü ehtiva etməlidir."`;
---

<!doctype html>
<html lang="az">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex,nofollow" />
		<title>Python Runtime — M1 Demo</title>
		<style>
			body {
				max-width: 760px;
				margin: 0 auto;
				padding: 2rem 1rem 4rem;
				font-family: system-ui, -apple-system, Segoe UI, sans-serif;
				color: #111;
				background: #fff;
			}
			h1 {
				font-size: 1.5rem;
			}
			h2 {
				font-size: 1.05rem;
				margin-top: 2rem;
			}
			p.note {
				color: #555;
				font-size: 0.9rem;
			}
		</style>
	</head>
	<body>
		<h1>Python Runtime — M1 + M2 Demo</h1>
		<p class="note">
			Internal verification page for milestones M1 (runtime core) and M2 (missions +
			progress). Not linked from the site.
		</p>

		<h2>1. Hello — stdout</h2>
		<p class="note">Run → output should show “Salam, Dünya!”.</p>
		<PyRunner id="demo-hello" starterCode={helloCode} />

		<h2>2. Error — type + line highlight</h2>
		<p class="note">Run → a NameError on line 3, with line 3 highlighted in the editor.</p>
		<PyRunner id="demo-error" starterCode={errorCode} />

		<h2>3. Infinite loop — killable + recycle</h2>
		<p class="note">
			Run → auto-stopped after ~5s. Then Run again → the worker is recreated and still works.
		</p>
		<PyRunner id="demo-loop" starterCode={loopCode} />

		<h2>4. Queued input()</h2>
		<p class="note">
			Open “Inputs”, put a name and an age on two lines, then Run.
		</p>
		<PyRunner id="demo-input" starterCode={inputCode} inputs={'Rüfət\n12'} />

		<h2>5. SyntaxError — line via .lineno fallback</h2>
		<p class="note">Run → SyntaxError on line 2 (no traceback frame; line comes from e.lineno).</p>
		<PyRunner id="demo-syntax" starterCode={syntaxCode} />

		<h2>6. Missions + progress (M2)</h2>
		<ModuleProgress moduleId="demo" missions={['demo-m-pass']} badgeLabel="Demo nişanı" />

		<Mission id="demo-m-pass" xp={10} title="Passing mission" starterCode={passStarter} checkCode={salamCheck}>
			Print the word <code>salam</code>. The starter is already correct — just press Run.
		</Mission>

		<Mission id="demo-m-fail" xp={10} title="Failing mission" starterCode={failStarter} checkCode={salamCheck}>
			This starter prints the wrong thing, so Run shows a hint instead of completing.
		</Mission>
	</body>
</html>
