      .toolbar a:hover { text-decoration: underline; }
      .toolbar button {
        background: var(--head);
        color: #fff;
        border: 0;
        border-radius: 8px;
        padding: 9px 16px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      .toolbar button:hover { background: #1e293b; }
      .sheet {
        background: #fff;
        max-width: 8.5in;
        margin: 0 auto 40px;
        padding: 0.6in 0.7in;
        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.12);
      }
      header { text-align: center; margin-bottom: 10px; }
      h1 { font-size: 23pt; margin: 0; letter-spacing: 0.5px; color: var(--head); }
      .title { font-size: 10.5pt; color: var(--muted); margin: 4px 0 6px; font-weight: 600; }
      .contact { font-size: 9.5pt; color: #334155; }
      .contact a { color: #334155; text-decoration: none; }
      h2 {
        font-size: 11.5pt;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--head);
        border-bottom: 1.5px solid var(--rule);
        padding-bottom: 2px;
        margin: 15px 0 6px;
      }
      .role {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 9px;
        gap: 16px;
      }
      .role .pos { font-weight: 700; }
      .role .pos .co { font-weight: 600; color: #334155; }
      .role .dates { font-size: 9pt; color: var(--muted); white-space: nowrap; }
      .blurb { font-style: italic; color: #334155; margin: 2px 0 4px; }
      ul { margin: 3px 0 4px; padding-left: 18px; }
      li { margin: 2px 0; }
      .tech { font-size: 9pt; color: var(--muted); margin-top: 3px; }
      .skills p { margin: 2px 0; }
      .skills b { color: var(--head); }
      p { margin: 4px 0; }
      @media print {
        @page { size: Letter; margin: 0.5in; }
        body { background: #fff; }
        .no-print { display: none !important; }
        .sheet { box-shadow: none; margin: 0; padding: 0; max-width: none; }
      }
    </style>
